{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rosudrag/mo2-map/snapshot/v2/schema.json",
  "title": "Snapshot Contract v2",
  "description": "Schema for versioned snapshot export. The export is defined by what the validator will accept; the validator lives in public so the validator cannot be coerced to accept what it should not. v2 drops every field that reconstructs collection activity (timestamps, sighting tallies, server/account identity) and the coverage report entirely, and publishes discoveries pre-aggregated by grid cell instead of one row per raw sighting.",

  "definitions": {
    "discovery_kind": {
      "type": "string",
      "enum": ["resource", "spawn", "npc", "structure", "container"]
    },
    "discovery_id": {
      "type": "string",
      "description": "First 8 hex characters of sha256(\"kind|cls|x|y\") over the published, post-aggregation integer position.",
      "pattern": "^[0-9a-f]{8}$"
    },
    "world_coordinate": {
      "type": "integer",
      "description": "World metres, integer — the centroid of one occupied grid cell."
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  },

  "definitions_by_file": {
    "discoveries.json": {
      "type": "array",
      "description": "Grid-aggregated discovery rows: one row per occupied (kind, cls, cell) bucket.",
      "items": {
        "type": "object",
        "required": ["id", "kind", "cls", "label", "x", "y", "z", "count"],
        "properties": {
          "id": { "$ref": "#/definitions/discovery_id" },
          "kind": { "$ref": "#/definitions/discovery_kind" },
          "cls": {
            "type": "string",
            "maxLength": 160,
            "description": "Game class token"
          },
          "label": {
            "type": "string",
            "maxLength": 128,
            "description": "Human-readable label"
          },
          "x": { "$ref": "#/definitions/world_coordinate" },
          "y": { "$ref": "#/definitions/world_coordinate" },
          "z": { "$ref": "#/definitions/world_coordinate" },
          "count": {
            "type": "integer",
            "minimum": 1,
            "description": "How many nodes were merged into this row — this many things here, not how many times seen"
          }
        },
        "additionalProperties": false
      }
    },

    "pins.json": {
      "type": "array",
      "description": "Curated/game-file POI catalogue",
      "items": {
        "type": "object",
        "required": ["id", "label", "type", "category", "map_x", "map_y"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "maxLength": 128
          },
          "type": { "type": "string" },
          "category": { "type": "string" },
          "map_x": {
            "type": "number",
            "description": "Canvas pixel X coordinate"
          },
          "map_y": {
            "type": "number",
            "description": "Canvas pixel Y coordinate"
          },
          "world_x": {
            "type": "number",
            "description": "World metres, if known"
          },
          "world_y": {
            "type": "number",
            "description": "World metres, if known"
          },
          "world_z": {
            "type": "number",
            "description": "World metres, if known"
          }
        },
        "additionalProperties": false
      }
    },

    "manifest.json": {
      "type": "object",
      "required": ["id", "schema_version", "generated", "counts"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Map identifier, e.g. \"sarducaa\""
        },
        "schema_version": {
          "type": "string",
          "description": "Schema version identifier"
        },
        "generated": { "$ref": "#/definitions/date" },
        "counts": {
          "type": "object",
          "description": "Count of items per file and per kind",
          "properties": {
            "discoveries": { "type": "integer" },
            "pins": { "type": "integer" },
            "by_kind": {
              "type": "object",
              "properties": {
                "resource": { "type": "integer" },
                "spawn": { "type": "integer" },
                "npc": { "type": "integer" },
                "structure": { "type": "integer" },
                "container": { "type": "integer" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
